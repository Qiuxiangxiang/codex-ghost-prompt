+fn extract_next_prompt_suggestion(answer: &str) -> Option<String> {
+    let lines: Vec<&str> = answer.lines().collect();
+    let mut found_heading = false;
+    for (index, line) in lines.iter().enumerate() {
+        let lower = line.to_lowercase();
+        if lower.contains("next prompt")
+            || ((line.contains("下一步") || line.contains("下一个")) && lower.contains("prompt"))
+        {
+            found_heading = true;
+            continue;
+        }
+        if !found_heading || !line.trim_start().starts_with("```") {
+            continue;
+        }
+        let mut candidate = Vec::new();
+        for content_line in lines.iter().skip(index + 1) {
+            if content_line.trim_start().starts_with("```") {
+                break;
+            }
+            candidate.push(*content_line);
+        }
+        let candidate = candidate.join("\n").trim().to_string();
+        if !candidate.is_empty() {
+            return Some(candidate);
+        }
+        found_heading = false;
+    }
+    None
+}
